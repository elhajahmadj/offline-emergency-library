# Keep Windows scripts with CRLF line endings on checkout
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Shell scripts MUST stay LF or they break on macOS/Linux
*.sh  text eol=lf
*.command text eol=lf
# Medical sidecar hashes describe exact generated UTF-8 bytes on every OS.
doc-qa/text/*.txt -text
